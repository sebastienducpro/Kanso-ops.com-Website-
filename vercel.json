{
  "redirects": [
    {
      "source": "/produit",
      "destination": "/cas-usage.html",
      "permanent": true
    },
    {
      "source": "/produit.html",
      "destination": "/cas-usage.html",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/en/product.html",
      "destination": "/en/case-studies.html",
      "permanent": true
    },
    {
      "source": "/automatisation-achats-p2p-s2p.html",
      "destination": "/cas-usage.html",
      "permanent": true
    },
    {
      "source": "/en/procurement-automation-p2p-s2p.html",
      "destination": "/en/case-studies.html",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.kanso-ops.com" }],
      "destination": "https://kanso-ops.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
