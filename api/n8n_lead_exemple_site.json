{
  "name": "Site · demande de l'exemple de cartographie",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "kanso-exemple", "responseMode": "lastNode", "options": {} },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Demande depuis le site",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-280, 0],
      "webhookId": "kanso-exemple"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.body.email }}", "rightValue": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", "operator": { "type": "string", "operation": "regex" } },
            { "id": "c2", "leftValue": "={{ $json.body.nom }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Lead complet",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [-60, 0]
    },
    {
      "parameters": {
        "fromEmail": "site@kanso-ops.com",
        "toEmail": "sebastien.duc@kanso-ops.fr",
        "subject": "=Exemple demandé par {{ $json.body.nom }}, {{ $json.body.societe }} · {{ $json.body.telephone }}",
        "emailFormat": "html",
        "html": "=<div style=\"font:15px/1.6 -apple-system,Segoe UI,Arial,sans-serif;color:#3a3550\"><p style=\"font:700 17px Arial;color:#140E59;margin:0 0 14px\">Une demande d'exemple vient d'arriver</p><table cellpadding=\"6\" style=\"border-collapse:collapse;font-size:15px\"><tr><td style=\"color:#7d7a8c\">Nom</td><td><b>{{ $json.body.nom }}</b></td></tr><tr><td style=\"color:#7d7a8c\">Société</td><td><b>{{ $json.body.societe }}</b></td></tr><tr><td style=\"color:#7d7a8c\">Fonction</td><td>{{ $json.body.fonction || 'non renseignée' }}</td></tr><tr><td style=\"color:#7d7a8c\">Courriel</td><td><a href=\"mailto:{{ $json.body.email }}\"><b>{{ $json.body.email }}</b></a></td></tr><tr><td style=\"color:#7d7a8c\">Téléphone</td><td><a href=\"tel:{{ $json.body.telephone }}\"><b>{{ $json.body.telephone }}</b></a></td></tr></table><p style=\"margin-top:18px;color:#7d7a8c;font-size:13.5px\">L'exemple lui a déjà été ouvert sur le site. Un appel deux ou trois jours plus tard vaut mieux qu'une relance écrite.</p></div>",
        "options": { "replyTo": "={{ $json.body.email }}" }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Prévenir Sébastien",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [160, 0]
    }
  ],
  "connections": {
    "Demande depuis le site": { "main": [[{ "node": "Lead complet", "type": "main", "index": 0 }]] },
    "Lead complet": { "main": [[{ "node": "Prévenir Sébastien", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
